# RIFFA Backend — шаблон для локальной разработки
# Скопируй в backend/.env и заполни API-ключи.
# Инфраструктурные значения (DB/Redis/MinIO) уже совпадают с ops/docker-compose.yml.

APP_ENV=development
APP_NAME=RIFFA Web
SECRET_KEY=local-dev-secret-not-for-prod
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Infra — docker-compose переопределяет эти значения через environment: ──
# Нужны только если запускаешь backend вне Docker (вариант "гибрид")
DATABASE_URL=postgresql+asyncpg://riffa:YOUR_POSTGRES_PASSWORD@localhost:5432/riffa
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_MEDIA=riffa-media
S3_ACCESS_KEY=riffa
S3_SECRET_KEY=YOUR_MINIO_PASSWORD
# !!! Локально — обязательно localhost, не riffastudio.site !!!
S3_PUBLIC_BASE_URL=http://localhost:9000/riffa-media

# ── ОБЯЗАТЕЛЬНО для работы генерации ──
SUNO_API_KEY=
OPENAI_BASE_URL=https://api.apiyi.com/v1
OPENAI_API_KEY=
APIYI_KEY=

# ── Cover art ──
NANOBANANA_API_KEY=
NANOBANANA_BASE_URL=https://api.apiyi.com/v1

# ── Агент — Perplexity поиск артиста ──
OPENROUTER_API_KEY=
LASTFM_API_KEY=

# ── Telegram (опционально для локальной разработки) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=The_Riffa_bot
TELEGRAM_CHANNEL_USERNAME=
ADMIN_TELEGRAM_IDS=

# ── Google OAuth (опционально) ──
GOOGLE_CLIENT_ID=

# ── Платежи — всегда TEST MODE локально ──
ROBOKASSA_MERCHANT_LOGIN=RIFFA
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_TEST_MODE=true
